# ── LLM (자연어 설명용, 필수) ──
OPENAI_API_KEY=sk-...
OPENAI_MODEL_NAME=gpt-4o-mini

# ── NAVER Cloud Platform Maps (지오코딩 + 지도, 필수) ──
# NCP 콘솔 > Services > Maps 에서 발급. 지오코딩(백엔드)과 지도표시(프론트)는 키가 다를 수 있음.
NCP_APIGW_KEY_ID=          # 백엔드 REST 지오코딩용 (x-ncp-apigw-api-key-id)
NCP_APIGW_KEY=             # 백엔드 REST 지오코딩용 (x-ncp-apigw-api-key)
VITE_NCP_MAP_KEY_ID=       # 프론트 지도표시용 (maps.js?ncpKeyId=...)

# ── 소진공 상가정보 (반경 경쟁점포 + 상권밖 폴백) ──
# data.go.kr '일반 인증키(Encoding)' 값을 그대로 붙여넣기(이중 인코딩 금지)
# End Point: https://apis.data.go.kr/B553077/api/open/sdsc2
SOSANGONG_SERVICE_KEY=

# ── 프론트가 바라볼 백엔드 주소 ──
VITE_API_BASE=http://localhost:8001
