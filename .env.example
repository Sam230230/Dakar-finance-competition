# Stay or Move — local demo first
# 서울시 상권 데이터는 data/seoul_market.sqlite에 포함되어 있어 서울시 Open API 키가 필요하지 않습니다.
DEMO_MODE=true
VITE_DEMO_MODE=true
# 기업마당 정책 데이터
BIZINFO_API_KEY=D8cCP3
BIZINFO_SEARCH_COUNT=0
# NAVER Maps
# 같은 Application의 Client ID/Secret을 사용합니다.
# Web Dynamic Map + Geocoding 활성화 권장.
# Web 서비스 URL: http://localhost (포트 제외)
NCP_APIGW_KEY_ID=YOUR_CLIENT_ID
NCP_APIGW_KEY=YOUR_CLIENT_SECRET
VITE_NCP_MAP_KEY_ID=YOUR_CLIENT_ID

# Optional: LLM explanation. 비워두면 규칙 기반 데모 설명으로 동작합니다.
OPENAI_API_KEY=

OPENAI_MODEL_NAME=gpt-4o-mini

# LLM 설명 생성(RAG Generation) on/off. DEMO_MODE와 독립적으로 동작한다.
# false면 OPENAI_API_KEY가 있어도 Retrieval-only(Rule Engine + 정책 검색)로만 응답.
ENABLE_LLM_EXPLANATION=true

# Frontend -> FastAPI
VITE_API_BASE=http://localhost:8001

# Optional: 소진공 API. 핵심 MVP에는 없어도 됩니다.
SOSANGONG_SERVICE_KEY=

# Optional: Hugging Face. 없어도 동작하지만 최초 모델 다운로드 시 rate limit 경고가 날 수 있습니다.
HF_TOKEN=
