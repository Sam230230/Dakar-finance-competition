# 이미지에서 172MB 를 덜어낸다. 학습·인덱스 빌드에만 쓰는 원본들이라
# 서빙에는 하나도 필요 없다. 런타임이 실제로 읽는 것만 남긴다.

# 학습 원본 (156MB). 단 sanggwon_synth.csv 는 합성 폴백 경로가 읽으므로 남긴다.
ml/data/**
!ml/data/sanggwon_synth.csv

# 정책 원문 PDF 등 (16MB). 질의에는 vector_db 만 쓴다.
policy_rag/data/

# 개발 부산물
.git/
.gitignore
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.playwright-cli/
output/
node_modules/
web/node_modules/
web/dist/

# 프론트는 별도 정적 사이트로 배포한다
web/

# 비밀값은 이미지에 굽지 않는다. Render 환경변수로 주입한다.
.env
.env.*
!.env.example

# 문서·시안
*.md
!README.md
docs/
scripts/

# OS
.DS_Store
